<Window x:Class="PicMark.CollageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PicMark"
        Title="拼图" Width="1100" Height="740" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" AllowsTransparency="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        FontFamily="{StaticResource AppUiFontFamily}">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2FA8FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F5F7"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFAEB4BE"/>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#FF383B40"/>
            <Setter Property="BorderBrush" Value="#FF50545A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#FF454A50"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#FF2D3034"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TemplateButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="DarkComboItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF454A50"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF236E9F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF454A50"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF69717B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF2A2D31"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF3F4349"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="{x:Type ComboBox}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="#FF383B40"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#FF50545A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Style="{StaticResource DarkComboToggle}"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" Margin="10,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Fill="{StaticResource TextSecondaryBrush}" Data="M 0 0 L 5 5 L 10 0 Z"/>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#FF303338" BorderBrush="#FF5A6068" BorderThickness="1" CornerRadius="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF000000" BlurRadius="14" ShadowDepth="4" Opacity="0.32"/>
                                        </Border.Effect>
                                    </Border>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF8F96A3"/>
                                <Setter TargetName="ContentSite" Property="Opacity" Value="0.72"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="#FF6F7680"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowShell" Background="#FF26282C" BorderBrush="#FF50545A" BorderThickness="1" CornerRadius="9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF303338" CornerRadius="9,9,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <TextBlock Text="拼图" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource BaseButton}" Width="38" Height="30" Padding="0" Margin="0" HorizontalContentAlignment="Center"
                                Click="Minimize_Click" ToolTip="最小化"><TextBlock Text="—"/></Button>
                        <Button Style="{StaticResource BaseButton}" Width="38" Height="30" Padding="0" Margin="5,0,0,0" HorizontalContentAlignment="Center"
                                Click="Close_Click" ToolTip="关闭"><TextBlock Text="×" FontSize="17"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FF2D3034" BorderBrush="#FF42464C" BorderThickness="0,0,1,0" Padding="13,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="模板" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="三格" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,2,0,6"/>
                            <Button Style="{StaticResource TemplateButton}" Tag="ThreeHorizontal" Click="Template_Click">横向三格</Button>
                            <Button Style="{StaticResource TemplateButton}" Tag="ThreeVertical" Click="Template_Click">竖向三格</Button>
                            <Button Style="{StaticResource TemplateButton}" Tag="ThreeTopOneBottomTwo" Click="Template_Click">上 1 下 2</Button>
                            <Button Style="{StaticResource TemplateButton}" Tag="ThreeLeftOneRightTwo" Click="Template_Click">左 1 右 2</Button>

                            <TextBlock Text="四格" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,8,0,6"/>
                            <Button Style="{StaticResource TemplateButton}" Tag="FourGrid" Click="Template_Click">四宫格</Button>
                            <Button Style="{StaticResource TemplateButton}" Tag="FourHorizontal" Click="Template_Click">横向四格</Button>
                            <Button Style="{StaticResource TemplateButton}" Tag="FourVertical" Click="Template_Click">竖向四格</Button>

                            <TextBlock Text="漫画" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,8,0,6"/>
                            <Button Style="{StaticResource TemplateButton}" Tag="ComicLeftLarge" Click="Template_Click">一大两小</Button>
                            <Button Style="{StaticResource TemplateButton}" Tag="ComicTopLarge" Click="Template_Click">一大三小</Button>

                            <TextBlock Text="长拼图" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,8,0,6"/>
                            <Button Style="{StaticResource TemplateButton}" Tag="SeamlessVertical" Click="Template_Click">无缝拼图</Button>
                            <Button Style="{StaticResource TemplateButton}" Tag="StackVertical" Click="Template_Click">上下拼</Button>
                            <Button Style="{StaticResource TemplateButton}" Tag="StackHorizontal" Click="Template_Click">左右拼</Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock x:Name="TemplateTitleText" Text="四宫格" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ImageCountHintText" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#FF1D1F22" BorderBrush="#FF454950" BorderThickness="1" CornerRadius="7" Padding="12">
                        <Viewbox Stretch="Uniform">
                            <local:CollageCanvas x:Name="CollagePreview" Width="800" Height="600" Focusable="True" AllowDrop="True"
                                                  SelectedIndexChanged="CollagePreview_SelectedIndexChanged"
                                                  EmptySlotClicked="CollagePreview_EmptySlotClicked"
                                                  EmptySlotDropped="CollagePreview_EmptySlotDropped"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="2" Text="单击空格直接添加图片；也可把图片拖进空格；拖动已添加图片调整位置；滚轮缩放；双击恢复。"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="2,9,2,0"/>
                </Grid>

                <Border Grid.Column="2" Background="#FF2D3034" BorderBrush="#FF42464C" BorderThickness="1,0,0,0" Padding="13,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="图片" Style="{StaticResource SectionTitle}"/>
                            <Button x:Name="AddImagesButton" Style="{StaticResource PrimaryButton}" Click="AddImages_Click">添加图片...</Button>
                            <ListBox x:Name="ImageListBox" Height="145" Margin="0,0,0,7"
                                     Background="#FF232529" Foreground="White" BorderBrush="#FF4A4E54"
                                     SelectionChanged="ImageListBox_SelectionChanged" DisplayMemberPath="DisplayName"/>
                            <UniformGrid Columns="3" Margin="0,0,0,13">
                                <Button Style="{StaticResource BaseButton}" Height="30" Margin="0,0,4,0" Padding="0" HorizontalContentAlignment="Center" Click="MoveUp_Click">上移</Button>
                                <Button Style="{StaticResource BaseButton}" Height="30" Margin="2,0" Padding="0" HorizontalContentAlignment="Center" Click="MoveDown_Click">下移</Button>
                                <Button Style="{StaticResource BaseButton}" Height="30" Margin="4,0,0,0" Padding="0" HorizontalContentAlignment="Center" Click="RemoveImage_Click">删除</Button>
                            </UniformGrid>

                            <TextBlock Text="画布比例" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="CanvasRatioCombo" Style="{StaticResource DarkCombo}" SelectionChanged="CanvasRatio_SelectionChanged">
                                <ComboBoxItem Content="原始尺寸 / 自动" Tag="Auto" IsSelected="True"/>
                                <ComboBoxItem Content="1:1" Tag="1:1"/>
                                <ComboBoxItem Content="4:3" Tag="4:3"/>
                                <ComboBoxItem Content="16:9" Tag="16:9"/>
                                <ComboBoxItem Content="A4 竖版" Tag="A4"/>
                            </ComboBox>

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="间距" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock x:Name="GapValueText" Text="12" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                            <Slider x:Name="GapSlider" Minimum="0" Maximum="40" Value="12" TickFrequency="1"
                                    Margin="0,0,0,13" ValueChanged="GapSlider_ValueChanged"/>

                            <TextBlock Text="背景" Style="{StaticResource SectionTitle}"/>
                            <UniformGrid Columns="3" Margin="0,0,0,13">
                                <Button Style="{StaticResource BaseButton}" Height="30" Margin="0,0,4,0" Padding="0" HorizontalContentAlignment="Center" Tag="White" Click="Background_Click">白色</Button>
                                <Button Style="{StaticResource BaseButton}" Height="30" Margin="2,0" Padding="0" HorizontalContentAlignment="Center" Tag="Black" Click="Background_Click">黑色</Button>
                                <Button Style="{StaticResource BaseButton}" Height="30" Margin="4,0,0,0" Padding="0" HorizontalContentAlignment="Center" Tag="Gray" Click="Background_Click">灰色</Button>
                            </UniformGrid>

                            <TextBlock Text="导出宽度" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="ExportWidthCombo" Style="{StaticResource DarkCombo}" SelectedIndex="1">
                                <ComboBoxItem Content="1200 像素" Tag="1200"/>
                                <ComboBoxItem Content="1600 像素" Tag="1600"/>
                                <ComboBoxItem Content="2400 像素" Tag="2400"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#FF303338" BorderBrush="#FF454950" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9">
                <Grid Margin="16,10">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Text="请添加图片"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BaseButton}" Width="120" Margin="0,0,8,0" HorizontalContentAlignment="Center" Click="ResetSelected_Click">恢复当前图片</Button>
                        <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Width="130" Margin="0" Click="Export_Click">导出拼图</Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
